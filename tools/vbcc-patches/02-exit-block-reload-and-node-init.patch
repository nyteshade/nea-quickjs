diff --git a/src/vbcc/parse_expr.c b/src/vbcc/parse_expr.c
index c88e7ef..3db1766 100644
--- a/src/vbcc/parse_expr.c
+++ b/src/vbcc/parse_expr.c
@@ -10,6 +10,13 @@ extern int no_alg_opt;
 np new_node(void)
 {
   np p=mymalloc(NODES);
+  /* Clear the whole node. type_expression2() tests val.vumax of an
+     ADDRESS node to decide whether "*&x" may be replaced by "x", and
+     nothing ever stores there: with only the fields below set, that
+     test read whatever malloc() returned, and the generated code
+     (correct either way, but different) depended on the heap's
+     history. Seen in quickjs.c's JS_CallInternal at -O=1. */
+  memset(p,0,NODES);
   p->flags=0;
   p->lvalue=0;
   p->sidefx=0;
