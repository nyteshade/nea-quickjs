+/*  Deferred IC frees: remove_IC() can run from add_IC() peepholes
+    while parser-level statement handlers (for/while/do in
+    statements.c) still hold saved IC cursors into the list. Freeing
+    the node immediately leaves those cursors dangling — the
+    mic->line/mic->file tagging walks then read freed memory, a
+    layout-dependent SIGSEGV (observed in for_statement on large
+    inputs). Instead the unlinked node is kept alive — its own
+    next/prev still point at its former neighbours, so a stale
+    cursor walks back into the live list — and the memory is
+    released in bulk at end of function via flush_deferred_ICs().  */
+static IC **ic_graveyard;
+static int ic_graveyard_cnt,ic_graveyard_max;
+void defer_free_IC(IC *p)
+{
+  if(ic_graveyard_cnt>=ic_graveyard_max){
+    ic_graveyard_max=ic_graveyard_max?2*ic_graveyard_max:64;
+    ic_graveyard=myrealloc(ic_graveyard,ic_graveyard_max*sizeof(IC *));
+  }
+  ic_graveyard[ic_graveyard_cnt++]=p;
 }
+void flush_deferred_ICs(void)
+{
+  int i;
+  for(i=0;i<ic_graveyard_cnt;i++) free(ic_graveyard[i]);
+  ic_graveyard_cnt=0;
+}
